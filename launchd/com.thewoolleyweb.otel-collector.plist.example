<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.thewoolleyweb.otel-collector</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>-i</string>
    <string>HOME=/Users/cwoolley</string>
    <string>PATH=/Users/cwoolley/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <string>__REPO_ROOT__/bin/run-macos-collector</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO_ROOT__</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>StandardOutPath</key>
  <string>__REPO_ROOT__/tmp/macos-local-collector/launchagent.out.log</string>

  <key>StandardErrorPath</key>
  <string>__REPO_ROOT__/tmp/macos-local-collector/launchagent.err.log</string>
</dict>
</plist>
