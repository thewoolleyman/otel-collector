# Copy this file to `.env` and fill in your values.
# `./run` will source `.env` automatically, and `docker compose` also picks it up.

# Required: ingest key for the Honeycomb environment most data lands in
# (the agent-activity env, for the Claude Code / host-metrics pipelines).
HONEYCOMB_API_KEY=

# Required: ingest key for the livespec Honeycomb env. The `traces/bd_guard`
# pipeline routes bd-guard spans (service.name=bd-guard, from the host `bd`
# wrapper) here instead of agent-activity. The collector will NOT start if this
# is unset while config.yaml references it.
HONEYCOMB_INGEST_KEY_LIVESPEC=

# Optional: default is US ingest. Set to api.eu1.honeycomb.io:443 if you're on EU.
# HONEYCOMB_API_ENDPOINT=api.honeycomb.io:443

# CI runner host (config.ci-runner-host.yaml, installed by
# scripts/install-ci-runner-host.sh): the file lives at /etc/otel-collector/.env
# and needs ONLY HONEYCOMB_INGEST_KEY_LIVESPEC (everything there exports to the
# livespec env). HONEYCOMB_API_ENDPOINT defaults via host.env.
