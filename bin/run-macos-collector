#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"
ENV_FILE="$REPO_ROOT/.env.local"

if [[ ! -f "$ENV_FILE" ]]; then
  echo "Missing $ENV_FILE" >&2
  exit 1
fi

set -a
# shellcheck source=/dev/null
source "$ENV_FILE"
set +a

: "${HONEYCOMB_API_ENDPOINT:=api.honeycomb.io:443}"

if [[ -z "${HONEYCOMB_API_KEY:-}" ]]; then
  echo "HONEYCOMB_API_KEY is required in $ENV_FILE" >&2
  exit 1
fi

OTELCOL_BIN="${OTELCOL_BIN:-}"
if [[ -z "$OTELCOL_BIN" ]]; then
  if command -v otelcol-contrib >/dev/null 2>&1; then
    OTELCOL_BIN="$(command -v otelcol-contrib)"
  elif [[ -x "$HOME/.local/bin/otelcol-contrib" ]]; then
    OTELCOL_BIN="$HOME/.local/bin/otelcol-contrib"
  else
    echo "otelcol-contrib not found on PATH or at $HOME/.local/bin/otelcol-contrib" >&2
    exit 1
  fi
fi

exec "$OTELCOL_BIN" --config "$REPO_ROOT/config.macos.yaml"
